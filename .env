# Server
PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=campus_connect
DB_USER=postgres
DB_PASSWORD=secure_db_password_123

# Security (CHANGE THESE TO YOUR OWN VALUES!)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_1234567890
OTP_PEPPER=your_otp_pepper_secret_change_this_in_production_1234567890

# OTP behavior
OTP_EXPIRY_MINUTES=10
JWT_SIGNUP_PROOF_EXPIRY=15m
REQUIRE_EMAIL_OTP=false

# Admin credentials
ADMIN_EMAIL=admin@campus-connect.local
ADMIN_PASSWORD=admin123456

# Optional email provider (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_AUDIENCE_NAME=Campus Connect

# Node environment
NODE_ENV=development
